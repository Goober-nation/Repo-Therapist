{
  "name": "repo-health-frontend",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-rules.mjs && vite",
    "build": "node scripts/sync-rules.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "check": "tsc --noEmit && node --test --test-concurrency=1 tests/*.test.js && node scripts/sync-rules.mjs && vite build",
    "format": "oxfmt",
    "sync-rules": "node scripts/sync-rules.mjs"
  },
  "dependencies": {
    "marked": "^18.0.14",
    "pdfmake": "0.3.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
