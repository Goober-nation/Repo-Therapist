# Gateway origin for Vite's same-origin development proxy.
GATEWAY_URL=http://localhost:8080
# Public site origin used in badge links (defaults to the page origin when empty).
VITE_PUBLIC_URL=
# Testing stands only: "true" shows a dev sign-in button instead of Yandex (gateway needs DEV_AUTH_BYPASS_USER_ID).
VITE_DEV_AUTH_BYPASS=
