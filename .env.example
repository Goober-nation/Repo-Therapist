SOURCECRAFT_PAT=
SOURCECRAFT_URL=https://api.sourcecraft.tech  # required by sourcecraft-wrapper-service itself, no built-in default

# SC_WRAPPER_ADDR=localhost:8083  # optional, sourcecraft-wrapper-service gRPC address
# SECURITY_WRAPPER_ADDR=localhost:8085  # optional, security-wrapper-service gRPC address
# GIT_HISTORY_DAYS=365            # optional, how far back to clone/extract commit history (default 365)
# CLONE_TIMEOUT=10m               # optional, repository-service limit per repo: clone + export + upload (default 10m)
# GRADE_TIMEOUT=4m                # optional, grade-service limit per repo, LLM wait runs inside it (default 4m)
# GRADE_JOB_TTL=30m              # optional, grade-service: how long a job's grading mode waits for repo.ready (default 30m)
# RATE_LIMIT=60                  # optional, gateway requests per client IP per window (docker-compose default 60, code default 10)
# RATE_LIMIT_WINDOW=1m           # optional, gateway rate-limit window
# PUBLIC_API_RATE_LIMIT=300      # optional, public JSON score API (GET /score/...) requests per client IP per window; badges and the widget are not limited
# PUBLIC_API_RATE_LIMIT_WINDOW=1m # optional, public score API rate-limit window
# S3_KEEP_REPO_DATA=false        # optional, grade-service: keep a repo's S3 export after grading (default: deleted)
# LLM_TIMEOUT=70s                 # optional, grade-service wait for repo.docs.graded; keep below GRADE_TIMEOUT
# CLONE_SHM_MIN_FREE_BYTES=157286400  # optional, repository-service: free /dev/shm needed to clone in RAM
# GRADING_REGRADE_INTERVAL=72h    # optional, aggregator: public regrade period
# GRADING_REGRADE_ON_START=false  # optional, aggregator: also regrade once at startup
# GRADING_REGRADE_LIMIT=20        # optional, aggregator: regrade only the top N public repos by SourceCraft rating (0 = all)
# GRADING_REGRADE_LIST_TIMEOUT=2m # optional, aggregator: limit for listing all public repos per regrade
# SERVICE_TOKEN=                  # aggregator: PAT for public regrade; docker-compose sets it from SOURCECRAFT_PAT
# LLM_REQUEST_TTL=2m              # optional, aggregator: suppresses duplicate LLM requests per repo view
# GRADING_REQUEST_LIMIT=10        # optional, aggregator: new gradings users may start per window, service-wide (0 = no limit)
# GRADING_REQUEST_WINDOW=10m      # optional, aggregator: window for GRADING_REQUEST_LIMIT
# ANALYTICS_REGRADE_MISSING=true  # optional, aggregator: regrade a repo whose grade has no analytics row yet (set false if analytics.enabled=false in grading.yaml)
# GRADING_LOCK_TIMEOUT=20m        # optional, aggregator: free a repo lock busy longer than this (keep above CLONE_TIMEOUT + GRADE_TIMEOUT); also the TTL of a private grading token in Redis
# SOURCECRAFT_MAX_PAGES=50        # optional, sourcecraft-wrapper: page cap (100/page) for issues etc.; affects grading
# APP_PORT=8083 / 8085            # optional, gRPC port of sourcecraft-wrapper (default 8083) / security-wrapper (default 8085)
# CLIENT_TIMEOUT=5                # optional, wrappers: timeout of calls to SourceCraft / AppSec, seconds (default 5)
# APPSEC_URL=https://appsec.sourcecraft.tech  # optional, security-wrapper: AppSec API base URL
# REPORT_POLL_INTERVAL_SECONDS=2 REPORT_POLL_TIMEOUT_SECONDS=60  # optional, security-wrapper: AppSec report polling
# CLONE_TMP_DIR=                  # optional, repository-service: explicit base directory for the temporary clone (default: /dev/shm when it has room, else disk)
# DB_SSL_MODE=disable             # optional, gateway/aggregator/rating: Postgres sslmode (default disable)
# LLM_DOCS_MODE=auto              # optional, llm-service: auto | llm | algorithmic documentation grading (see docs/grading/documentation.md)
# LLM_ADVICE_PATH=                # optional, llm-service: path to the advice catalog (default: backend/llm-service/config/advice.yaml)
# S3_USE_SSL=false                # optional, llm-service: TLS for the S3 endpoint

# HTTP_READ_HEADER_TIMEOUT=5s 
# HTTP_READ_TIMEOUT=15s 
# HTTP_WRITE_TIMEOUT=30s 
# HTTP_IDLE_TIMEOUT=60s  # optional, gateway

# S3_CONNECT_TIMEOUT=5 S3_READ_TIMEOUT=15  # optional, llm-service S3 timeouts in seconds
# LLM_PRIORITY_THRESHOLD=75       # optional, llm-service recommendation priority boundary (0-100); old name LLM_STRENGTH_THRESHOLD still read
# LLM_DOCS_REQUEST_MAX_AGE_SECONDS=70  # optional, llm-service skips older docs requests without a model call
# KAFKA_*_TOPIC                   # optional topic renames, see docs/kafka-contracts.md "Topic env vars"

S3_ENDPOINT=localhost:8054
KAFKA_BROKERS=localhost:8053  # host-run services; containers use kafka:29092
S3_ACCESS_KEY=change-me          # required; also the RustFS (S3) root user in docker-compose
S3_SECRET_KEY=change-me-too       # required; also the RustFS (S3) root password (min 8 chars)
S3_BUCKET=repo-content

# Redis: gateway sessions/rate limiting and private grading tokens. docker-compose sets
# requirepass from REDIS_PASSWORD; host-run services use localhost:8052.
REDIS_PASSWORD=change-me-redis   # required
REDIS_ADDRESS=localhost:8052     # host-run services; containers use redis:6379

POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DB=repotherapist
POSTGRES_DSN=postgres://change-me:change-me@localhost:8051/repotherapist?sslmode=disable

# Optional public Yandex OAuth Client ID used by the frontend sign-in button.
VITE_YANDEX_CLIENT_ID= 
