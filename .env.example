# Secrets only. Every other setting lives in config/app.yaml (docs/config.md): edit it there, or in
# the admin panel ("Доступ админа" → "Настройки сервисов") for the keys it offers.
#
# Precedence: environment (this file, docker-compose, the shell) > admin panel > config/app.yaml > code.
# Anything set here wins over app.yaml and the admin panel for the whole life of the process, and the
# admin panel shows it as "задано в окружении". So do not copy app.yaml keys here unless you mean to
# pin them; an empty value (FOO=) also counts as set.

# Required: public clones, the Security category and scheduled regrades need it
# (docker-compose also passes it as SERVICE_TOKEN).
SOURCECRAFT_PAT=
# SERVICE_TOKEN=

S3_ACCESS_KEY=
S3_SECRET_KEY=

# docker-compose builds the Postgres container and the services' DB settings from these.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Host-run services: DB_USER / DB_PASSWORD (gateway, aggregator, rating), POSTGRES_DSN (tools).
# DB_USER=
# DB_PASSWORD=
# POSTGRES_DSN=

# Redis requirepass; docker-compose passes it to the services.
REDIS_PASSWORD=

# Yandex AI Studio (llm-service): the key and its folder. Without them Documentation is graded
# algorithmically and AI summaries are off.
YANDEX_AI_API_KEY=
YANDEX_FOLDER_ID=

# "Доступ админа" (docs/admin.md): off until ADMIN_PASSWORD or ADMIN_YANDEX_IDS is set.
# ADMIN_PASSWORD=
# ADMIN_YANDEX_IDS=
# AUDIT_HASH_SECRET=
# Testing stands only: any token signs in as this Yandex ID (with frontend.vite_dev_auth_bypass: true
# in app.yaml for the button). Empty = off.
# DEV_AUTH_BYPASS_USER_ID=

# Prometheus container retention (docker-compose only), default 15d.
# PROMETHEUS_RETENTION=15d
