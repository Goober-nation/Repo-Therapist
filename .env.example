# Required: public clones, the Security category and scheduled regrades need it (docker-compose also passes it as SERVICE_TOKEN).
SOURCECRAFT_PAT=
SOURCECRAFT_URL=https://api.sourcecraft.tech  # required by sourcecraft-wrapper-service itself, no built-in default

# Dependencies between the optional settings below (every one has a working default on its own):
# - Time limits: GRADING_LOCK_TIMEOUT must stay above CLONE_TIMEOUT + GRADE_TIMEOUT (the aggregator logs
#   a warning otherwise); LLM_TIMEOUT below GRADE_TIMEOUT (grade-service logs a warning);
#   BATCH_GRADING_ITEM_TIMEOUT should cover CLONE_TIMEOUT + GRADE_TIMEOUT. The frontend stops waiting
#   after 15m (POLL_TIMEOUT_MS in frontend/src/useRepositoryAnalysis.ts): raise it with these.
# - AGGREGATOR_GRPC_TIMEOUT (gateway) and GRPC_TIMEOUT (aggregator) are raised together.
# - Ports when running services on the host: APP_PORT of sourcecraft-wrapper, SC_WRAPPER_ADDR
#   (repository-service) and WRAPPER_GRPC_ADDRESS (aggregator) must name the same port (default 8082).
#   In Docker the entrypoint and docker-compose set them, so APP_PORT, METRICS_ADDRESS, LLM_METRICS_PORT,
#   *_ADDR, KAFKA_BROKERS, S3_ENDPOINT, REDIS_ADDRESS, POSTGRES_DSN and SERVICE_TOKEN from this file are ignored there.
# - SERVICE_TOKEN is needed for GRADING_REGRADE_* to do anything.
# - ADMIN_UNLOCK_*, ADMIN_DENIED_LOG_* and AUDIT_HASH_SECRET only matter once ADMIN_PASSWORD or
#   ADMIN_YANDEX_IDS is set; without AUDIT_HASH_SECRET the audit hashes change when those change.
# - SERIES_CACHE_SECONDS only matters with PROMETHEUS_URL set.
# - RANKING_SIZE_LARGE_LOC must exceed RANKING_SIZE_SMALL_LOC, otherwise both are reset to defaults.
# - ANALYTICS_REGRADE_MISSING=true needs analytics.enabled in config/grading.yaml (else repos are regraded forever).
# - S3_USE_SSL must match the S3_ENDPOINT scheme.
# Invalid values fall back to the default with a log line, except LLM_DOCS_MODE, S3_USE_SSL and
# LLM_DOCS_REQUEST_MAX_AGE_SECONDS (llm-service refuses to start) and GIT_HISTORY_DAYS (every clone fails).

# SC_WRAPPER_ADDR=localhost:8082  # optional, sourcecraft-wrapper-service gRPC address
# SECURITY_WRAPPER_ADDR=localhost:8085  # optional, security-wrapper-service gRPC address
# GIT_HISTORY_DAYS=365            # optional, how far back to clone/extract commit history (default 365)
# CLONE_TIMEOUT=10m               # optional, repository-service limit per repo: clone + export + upload (default 10m)
# GRADE_TIMEOUT=4m                # optional, grade-service limit per repo, LLM wait runs inside it (default 4m)
# GRADE_JOB_TTL=30m              # optional, grade-service: how long a job's grading mode waits for repo.ready (default 30m)
# RATE_LIMIT=60                  # optional, gateway requests per client IP per window (docker-compose default 60, code default 10 when run on the host)
# RATE_LIMIT_WINDOW=1m           # optional, gateway rate-limit window
# PUBLIC_API_RATE_LIMIT=300      # optional, public JSON score API (GET /score/...) requests per client IP per window; badges and the widget are not limited
# PUBLIC_API_RATE_LIMIT_WINDOW=1m # optional, public score API rate-limit window
# S3_KEEP_REPO_DATA=false        # optional, grade-service: keep a repo's S3 export after grading (default: deleted)
# LLM_TIMEOUT=70s                 # optional, grade-service wait for repo.docs.graded; keep below GRADE_TIMEOUT
# CLONE_SHM_MIN_FREE_BYTES=157286400  # optional, repository-service: free /dev/shm needed to clone in RAM
# GRADING_REGRADE_INTERVAL=72h    # optional, aggregator: public regrade period (0 turns the schedule off); the ranking page shows the countdown
# GRADING_REGRADE_ON_START=false  # optional, aggregator: also regrade once at startup
# GRADING_REGRADE_LIMIT=500       # optional, aggregator: scheduled regrade covers the top N public repos by SourceCraft rating (0 = all); a graded repo is regraded only after new SourceCraft activity
# GRADING_REGRADE_LIST_TIMEOUT=2m # optional, aggregator: limit for listing all public repos per regrade
# SERVICE_TOKEN=                  # aggregator: PAT for public regrade; docker-compose sets it from SOURCECRAFT_PAT
# LLM_REQUEST_TTL=2m              # optional, aggregator: suppresses duplicate LLM requests per repo view
# GRADING_REQUEST_LIMIT=10        # optional, aggregator: new gradings users may start per window, service-wide (0 = no limit)
# GRADING_REQUEST_WINDOW=10m      # optional, aggregator: window for GRADING_REQUEST_LIMIT
# AGGREGATOR_GRPC_TIMEOUT=10s     # optional, gateway: wait for the aggregator per request (a private view scans the token owner's /me/repos: raise it, with GRPC_TIMEOUT, for accounts with many repos)
# GRPC_TIMEOUT=10s                # optional, aggregator: wait for sourcecraft-wrapper calls (see above)
# RANKING_SIZE_SMALL_LOC=2000     # optional, rating-service: below this many lines of code a repo is "small" in the ranking's size filter
# RANKING_SIZE_LARGE_LOC=20000    # optional, rating-service: from this many lines of code a repo is "large" (must exceed the small limit)
# EXPORT_RATE_LIMIT=5            # optional, gateway: public grades export requests per client IP per window
# EXPORT_RATE_LIMIT_WINDOW=1m    # optional, export rate-limit window
# ADMIN_YANDEX_IDS=               # optional, gateway: Yandex IDs of the admins, comma-separated; empty = no admins
# ADMIN_PASSWORD=                 # optional, gateway: password of the "Доступ админа" tab, plain text; empty = password unlock off; nothing else is needed
# ADMIN_UNLOCK_MAX_ATTEMPTS=5     # optional, gateway: wrong passwords in a row (per IP and per account) before the lock
# ADMIN_UNLOCK_LOCK=15m           # optional, gateway: how long the lock lasts
# AUDIT_HASH_SECRET=              # optional, gateway: key of the audit-log actor hash; derived from ADMIN_PASSWORD / ADMIN_YANDEX_IDS when empty (hashes then change with them)
# ADMIN_DENIED_LOG_LIMIT=5        # optional, gateway: refused admin attempts per client IP that reach the audit log per window
# ADMIN_DENIED_LOG_WINDOW=10m     # optional, gateway: window of that budget
# USER_AUDIT_WINDOW=5m            # optional, gateway: an identical user action is logged once per window; 0 turns it off
# AUDIT_RETENTION_DAYS=30         # optional, aggregator: audit entries older than this are deleted; 0 keeps them
# PROMETHEUS_RETENTION=15d        # optional, prometheus: how long metrics are kept
# PROMETHEUS_URL=http://prometheus:9090  # optional, gateway: where the graphs read their series; empty = graphs off
# SERIES_CACHE_SECONDS=60         # optional, gateway: how long one graph answer is reused
# LLM_METRICS_PORT=              # optional, llm-service: serve model call and token metrics on this port; set by compose (9104, 9105), empty = off
# METRICS_ADDRESS=                # optional, gateway/aggregator/rating: serve /metrics on this address; set per service by the entrypoint
# BATCH_GRADING_CONCURRENCY=3     # optional, aggregator: repos of an admin batch grading graded at once
# CATALOG_MAX_PAGES=2000          # optional, aggregator: page cap (100/page) of one public repo catalog refresh from the admin panel; past it the refresh fails and the old catalog stays
# BATCH_GRADING_ITEM_TIMEOUT=15m  # optional, aggregator: how long to wait for one repo's result
# BATCH_GRADING_MAX_LIMIT=0       # optional, aggregator: largest "at most N repos" an admin may ask for in one batch (0 = no cap; e.g. 20 on a demo stand)
# ANALYTICS_CACHE_SECONDS=300    # optional, rating-service: how long the platform analytics are reused
# RANKING_DYNAMICS_DAYS=7         # optional, rating-service: window of the score/place change shown in the ranking
# ANALYTICS_REGRADE_MISSING=true  # optional, aggregator: regrade a repo whose grade has no analytics row yet (set false if analytics.enabled=false in grading.yaml)
# GRADING_LOCK_TIMEOUT=20m        # optional, aggregator: free a repo lock busy longer than this (keep above CLONE_TIMEOUT + GRADE_TIMEOUT); also the TTL of a private grading token in Redis
# SOURCECRAFT_MAX_PAGES=50        # optional, sourcecraft-wrapper: page cap (100/page) for issues etc.; affects grading
# PR_SAMPLE_LIMIT=20              # optional, repository-service: how many newest pull requests feed the review analytics (0 = off, max 100)
# ISSUE_REPLY_SAMPLE_LIMIT=25     # optional, repository-service: how many newest issues feed the first-reply metric (0 = off)
# APP_PORT=8082                   # optional, gRPC port of sourcecraft-wrapper (default 8082) or security-wrapper (default 8085), per service
# CLIENT_TIMEOUT=5                # optional, wrappers: timeout of calls to SourceCraft / AppSec, seconds (default 5)
# APPSEC_URL=https://appsec.sourcecraft.tech  # optional, security-wrapper: AppSec API base URL
# REPORT_POLL_INTERVAL_SECONDS=2  # optional, security-wrapper: AppSec report polling interval
# REPORT_POLL_TIMEOUT_SECONDS=60  # optional, security-wrapper: AppSec report polling limit
# CLONE_TMP_DIR=                  # optional, repository-service: explicit base directory for the temporary clone (default: /dev/shm when it has room, else disk)
# DB_SSL_MODE=disable             # optional, gateway/aggregator/rating: Postgres sslmode (default disable)
# LLM_DOCS_MODE=algorithmic       # optional, llm-service: auto | llm | algorithmic documentation grading; docker-compose defaults to algorithmic (model off), set auto to use the model (see docs/grading/documentation.md)
# LLM_ADVICE_PATH=                # optional, llm-service: path to the advice catalog (default: backend/llm-service/config/advice.yaml)
# S3_USE_SSL=false                # optional, llm-service: TLS for the S3 endpoint

# HTTP_READ_HEADER_TIMEOUT=5s     # optional, gateway
# HTTP_READ_TIMEOUT=15s           # optional, gateway
# HTTP_WRITE_TIMEOUT=30s          # optional, gateway
# HTTP_IDLE_TIMEOUT=60s           # optional, gateway

# S3_CONNECT_TIMEOUT=5            # optional, llm-service S3 connect timeout, seconds
# S3_READ_TIMEOUT=15              # optional, llm-service S3 read timeout, seconds
# LLM_PRIORITY_THRESHOLD=75       # optional, llm-service recommendation priority boundary (0-100); old name LLM_STRENGTH_THRESHOLD still read
# LLM_DOCS_REQUEST_MAX_AGE_SECONDS=70  # optional, llm-service skips older docs requests without a model call
# Optional Kafka topic renames (KAFKA_..._TOPIC): see docs/kafka-contracts.md "Topic env vars"

VITE_PUBLIC_URL=http://localhost:8081 # set to use with a real domain

S3_ENDPOINT=localhost:8054
KAFKA_BROKERS=localhost:8053  # host-run services; containers use kafka:29092
S3_ACCESS_KEY=change-me          # required; also the RustFS (S3) root user in docker-compose
S3_SECRET_KEY=change-me-too       # required; also the RustFS (S3) root password (min 8 chars)
S3_BUCKET=repo-content

# Redis: gateway sessions/rate limiting and private grading tokens. docker-compose sets
# requirepass from REDIS_PASSWORD; host-run services use localhost:8052.
REDIS_PASSWORD=change-me-redis   # required
REDIS_ADDRESS=localhost:8052     # host-run services; containers use redis:6379

POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DB=repotherapist
POSTGRES_DSN=postgres://change-me:change-me@localhost:8051/repotherapist?sslmode=disable

# Optional public Yandex OAuth Client ID used by the frontend sign-in button.
VITE_YANDEX_CLIENT_ID= 
